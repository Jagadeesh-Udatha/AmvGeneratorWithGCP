# ============================================
# Anime Video Generator — Environment Config
# ============================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# --- LLM Provider (need at least ONE) ---
# OpenAI (recommended, ~$0.001 per video)
OPENAI_API_KEY=

# Google Gemini (free alternative)
GEMINI_API_KEY=

# --- Image Provider (need at least ONE) ---
# Pexels (free, 200 requests/hour)
PEXELS_API_KEY=

# Pixabay (free fallback, 100 requests/minute)
PIXABAY_API_KEY=

# --- Service Config ---
PORT=4000
TTS_SERVICE_URL=http://localhost:5050

# --- Optional ---
# anthropic (if you want to use Claude instead)
# ANTHROPIC_API_KEY=
